generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id        String @id @default(cuid())
  name      String
  state     String
  centerLat Float
  centerLng Float

  companies  Company[]
  candidates Candidate[]
  drives     Drive[]

  @@map("cities")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  gstin              String?
  verificationStatus VerificationStatus @default(PENDING)
  contactPhone       String
  cityId             String
  createdAt          DateTime           @default(now())

  city   City    @relation(fields: [cityId], references: [id])
  users  User[]
  drives Drive[]

  @@index([cityId])
  @@map("companies")
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  role      UserRole
  companyId String?
  createdAt DateTime @default(now())

  company   Company?   @relation(fields: [companyId], references: [id])
  candidate Candidate?
  auditLogs AuditLog[]

  @@index([companyId])
  @@map("users")
}

model Candidate {
  id              String                                 @id @default(cuid())
  userId          String                                 @unique
  cityId          String
  homeLat         Float
  homeLng         Float
  maxTravelKm     Float
  experienceYears Float
  resumeKey       String?
  telegramChatId  String?                                @unique
  // attended / confirmed over past drives, recomputed nightly; null until
  // the candidate has confirmed for at least one drive.
  reliability          Float?
  reliabilityUpdatedAt DateTime?
  // Populated by a DB trigger from homeLat/homeLng; not writable through Prisma.
  geom            Unsupported("geography(Point, 4326)")?

  user         User            @relation(fields: [userId], references: [id])
  city         City            @relation(fields: [cityId], references: [id])
  roles         CandidateRole[]
  applications  Application[]
  notifications Notification[]

  @@index([cityId])
  @@index([geom], type: Gist, map: "candidates_geom_gist")
  @@map("candidates")
}

model Role {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  candidates CandidateRole[]
  drives     Drive[]

  @@map("roles")
}

model CandidateRole {
  candidateId String
  roleId      String

  candidate Candidate @relation(fields: [candidateId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])

  @@id([candidateId, roleId])
  @@map("candidate_roles")
}

enum DriveStatus {
  DRAFT
  PENDING
  LIVE
  EXPIRED
  CANCELLED
}

model Drive {
  id                 String                                 @id @default(cuid())
  companyId          String
  roleId             String
  cityId             String
  salaryMin          Int
  salaryMax          Int
  venueAddress       String
  venueLat           Float
  venueLng           Float
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int
  experienceMin      Float
  experienceMax      Float
  status             DriveStatus                            @default(DRAFT)
  needsManualGeocode Boolean                                @default(false)
  // Set when the employer placed the venue from a device at the venue. Area
  // geocoding can be a kilometre off, so a pinned point is kept until the
  // address itself changes.
  venuePinnedAt      DateTime?
  // Populated by a DB trigger from venueLat/venueLng; not writable through Prisma.
  geom               Unsupported("geography(Point, 4326)")?

  company      Company       @relation(fields: [companyId], references: [id])
  role         Role          @relation(fields: [roleId], references: [id])
  city         City          @relation(fields: [cityId], references: [id])
  slots         DriveSlot[]
  applications  Application[]
  notifications Notification[]

  @@index([companyId])
  @@index([roleId])
  @@index([geom], type: Gist, map: "drives_geom_gist")
  @@map("drives")
}

model DriveSlot {
  id          String   @id @default(cuid())
  driveId     String
  startsAt    DateTime
  capacity    Int
  bookedCount Int      @default(0)

  drive        Drive         @relation(fields: [driveId], references: [id])
  applications Application[]

  @@index([driveId])
  @@map("drive_slots")
}

enum ApplicationState {
  INTERESTED
  CONFIRMED
  CHECKED_IN
  INTERVIEWED
  HIRED
  NO_SHOW
  REJECTED
  WITHDRAWN
}

model Application {
  id             String           @id @default(cuid())
  driveId        String
  candidateId    String
  slotId         String?
  state          ApplicationState @default(INTERESTED)
  stateChangedAt DateTime         @default(now())

  drive     Drive      @relation(fields: [driveId], references: [id])
  candidate Candidate  @relation(fields: [candidateId], references: [id])
  slot      DriveSlot? @relation(fields: [slotId], references: [id])
  checkIn   CheckIn?

  // One application per candidate per drive, enforced here rather than by a
  // check-then-insert, so two concurrent applies cannot both land. A release
  // is a move to WITHDRAWN, not a delete, so the row (and this guarantee)
  // survives and re-applying reuses it.
  @@unique([driveId, candidateId])
  @@index([candidateId])
  @@index([slotId])
  @@map("applications")
}

enum CheckInMethod {
  SCAN
  WALK_IN
  MANUAL
}

// Location fields are null for a MANUAL check-in: the employer marked the
// person present, so there is no reading. isValid false means "accepted but
// needs an employer's confirmation", with the reason in flagReason.
model CheckIn {
  id             String        @id @default(cuid())
  applicationId  String        @unique
  method         CheckInMethod
  scannedAt      DateTime      @default(now())
  // Client-reported time of an offline scan that synced later; untrusted,
  // shown to the employer next to scannedAt, never used to accept a token.
  capturedAt     DateTime?
  lat            Float?
  lng            Float?
  accuracyMeters Float?
  distanceMeters Float?
  isValid        Boolean
  flagReason     String?

  application Application @relation(fields: [applicationId], references: [id])

  @@map("check_ins")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// One row per send attempt, so retries leave a trail instead of overwriting
// the last error. A partial unique index in the migration SQL (Prisma cannot
// express one) allows at most one PENDING or SENT row per drive, candidate
// and template: an attempt claims that slot before calling the provider, so
// no retry, redelivery or duplicate job can send the same alert twice.
model Notification {
  id                String             @id @default(cuid())
  candidateId       String
  driveId           String
  channel           String
  templateKey       String
  status            NotificationStatus
  attempt           Int
  jobId             String
  providerMessageId String?
  error             String?
  createdAt         DateTime           @default(now())
  sentAt            DateTime?
  // Only for channels that report delivery; Telegram does not.
  deliveredAt       DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id])
  drive     Drive     @relation(fields: [driveId], references: [id])

  @@index([driveId, candidateId])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}
