generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id        String @id @default(cuid())
  name      String
  state     String
  centerLat Float
  centerLng Float

  companies  Company[]
  candidates Candidate[]
  drives     Drive[]

  @@map("cities")
}

// UNSUBMITTED: nothing sent for review yet. PENDING: a submission is
// waiting for an admin, and the company may run drives at limited reach.
// REJECTED companies can resubmit; until they do, they can't go live.
enum VerificationStatus {
  UNSUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  gstin              String?
  verificationStatus VerificationStatus @default(UNSUBMITTED)
  contactPhone       String
  cityId             String
  createdAt          DateTime           @default(now())
  // ISO 639-1 codes of the languages this company's staff read. A voice
  // transcript in any other language is not shown as text to them, only
  // flagged, because script they can't read is worse than no transcript.
  readsLanguages     String[]           @default(["en", "hi"])
  // Set by moderation. A suspended company keeps read-only access to its
  // desk; every drive it had open is suspended with it.
  suspendedAt        DateTime?

  city              City                     @relation(fields: [cityId], references: [id])
  users             User[]
  drives            Drive[]
  paymentOrders     PaymentOrder[]
  invitations       CompanyInvitation[]
  submissions       VerificationSubmission[]
  moderationActions ModerationAction[]
  warnings          Warning[]

  @@index([cityId])
  @@map("companies")
}

// Which side of the product a person uses.
enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

// What a person may do inside their company: a second axis next to
// UserRole, set together with companyId (a check constraint in the migration
// holds the pair). What each role allows is COMPANY_PERMISSIONS in
// @walkins/shared, read by the API and the web alike.
enum CompanyRole {
  OWNER
  RECRUITER
  VIEWER
}

model User {
  id          String       @id @default(cuid())
  phone       String       @unique
  name        String
  role        UserRole
  companyId   String?
  companyRole CompanyRole?
  createdAt   DateTime     @default(now())

  company              Company?                 @relation(fields: [companyId], references: [id])
  candidate            Candidate?
  auditLogs            AuditLog[]
  paymentOrders        PaymentOrder[]
  ownedDrives          Drive[]                  @relation("DriveOwner")
  shortlisted          Application[]            @relation("ShortlistedBy")
  invitationsSent      CompanyInvitation[]      @relation("InvitedBy")
  invitationsAccepted  CompanyInvitation[]      @relation("AcceptedBy")
  invitationsRevoked   CompanyInvitation[]      @relation("RevokedBy")
  submissions          VerificationSubmission[] @relation("SubmittedBy")
  decisions            VerificationSubmission[] @relation("DecidedBy")
  reportsMade          Report[]
  moderationActions    ModerationAction[]
  warningsAcknowledged Warning[]
  reschedules          DriveReschedule[]
  messagesSent         Message[]                @relation("MessageSender")
  threadsRead          MessageThread[]          @relation("CompanyReader")
  flagsReviewed        Message[]                @relation("FlagReviewer")

  @@index([companyId])
  @@map("users")
}

model Candidate {
  id                   String                                 @id @default(cuid())
  userId               String                                 @unique
  cityId               String
  homeLat              Float
  homeLng              Float
  maxTravelKm          Float
  experienceYears      Float
  resumeKey            String?
  telegramChatId       String?                                @unique
  // attended / confirmed over past drives, recomputed nightly; null until
  // the candidate has confirmed for at least one drive.
  reliability          Float?
  reliabilityUpdatedAt DateTime?
  // Populated by a DB trigger from homeLat/homeLng; not writable through Prisma.
  geom                 Unsupported("geography(Point, 4326)")?
  // Multilingual MiniLM over roles, experience and the voice transcript;
  // written by the worker. Null until first embedded, and ranking then
  // falls back to distance alone.
  embedding            Unsupported("vector(384)")?
  embeddedAt           DateTime?

  user              User               @relation(fields: [userId], references: [id])
  city              City               @relation(fields: [cityId], references: [id])
  roles             CandidateRole[]
  applications      Application[]
  notifications     Notification[]
  voiceIntros       VoiceIntro[]
  reports           Report[]
  warnings          Warning[]
  moderationActions ModerationAction[]

  @@index([cityId])
  @@index([geom], type: Gist, map: "candidates_geom_gist")
  @@map("candidates")
}

model Role {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  candidates CandidateRole[]
  drives     Drive[]

  @@map("roles")
}

model CandidateRole {
  candidateId String
  roleId      String

  candidate Candidate @relation(fields: [candidateId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])

  @@id([candidateId, roleId])
  @@map("candidate_roles")
}

// SUSPENDED is its own status rather than a flag beside LIVE, so every
// check that a drive is LIVE (search, applying, check-in, alerts) refuses a
// suspended drive without being told about suspension.
enum DriveStatus {
  DRAFT
  PENDING
  LIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum SuspensionCause {
  DRIVE
  COMPANY
}

model Drive {
  id                 String                                 @id @default(cuid())
  companyId          String
  roleId             String
  cityId             String
  salaryMin          Int
  salaryMax          Int
  venueAddress       String
  venueLat           Float
  venueLng           Float
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int
  experienceMin      Float
  experienceMax      Float
  status             DriveStatus                            @default(DRAFT)
  // The recruiter answerable for the drive: its creator, until an owner
  // reassigns it or the person leaves. Accountability only: any recruiter
  // at the company may run any of its drives, since on the day whoever is
  // at the desk works it.
  ownerId            String
  // While SUSPENDED: the status to restore when it is lifted, and whether
  // the drive itself or its whole company was suspended. Lifting a company
  // restores only the drives its suspension caused.
  suspendedFrom      DriveStatus?
  suspendedCause     SuspensionCause?
  // Counts reschedules. Alerts about the drive's time carry it, so a
  // reminder for the new day isn't mistaken for the one already sent for
  // the old day, and an alert about a superseded time is skipped.
  scheduleVersion    Int                                    @default(0)
  needsManualGeocode Boolean                                @default(false)
  // Set when the employer placed the venue from a device at the venue. Area
  // geocoding can be a kilometre off, so a pinned point is kept until the
  // address itself changes.
  venuePinnedAt      DateTime?
  // Up to five pass/fail questions answered when applying; shape and
  // evaluation are defined by knockoutQuestionsSchema in @walkins/shared.
  // Editable only while DRAFT or PENDING, so answers are always judged
  // against the questions the candidate saw.
  knockoutQuestions  Json                                   @default("[]")
  // Populated by a DB trigger from venueLat/venueLng; not writable through Prisma.
  geom               Unsupported("geography(Point, 4326)")?
  // Multilingual MiniLM over role, pay band and venue area; written by the worker.
  embedding          Unsupported("vector(384)")?
  embeddedAt         DateTime?

  company           Company            @relation(fields: [companyId], references: [id])
  owner             User               @relation("DriveOwner", fields: [ownerId], references: [id])
  role              Role               @relation(fields: [roleId], references: [id])
  city              City               @relation(fields: [cityId], references: [id])
  slots             DriveSlot[]
  applications      Application[]
  notifications     Notification[]
  reports           Report[]
  moderationActions ModerationAction[]
  reschedules       DriveReschedule[]

  @@index([companyId])
  @@index([ownerId])
  @@index([roleId])
  @@index([geom], type: Gist, map: "drives_geom_gist")
  @@map("drives")
}

model DriveSlot {
  id          String   @id @default(cuid())
  driveId     String
  startsAt    DateTime
  capacity    Int
  bookedCount Int      @default(0)

  drive        Drive         @relation(fields: [driveId], references: [id])
  applications Application[]

  @@index([driveId])
  @@map("drive_slots")
}

enum ApplicationState {
  INTERESTED
  CONFIRMED
  CHECKED_IN
  INTERVIEWED
  HIRED
  NO_SHOW
  REJECTED
  WITHDRAWN
  // Failed a knockout question when applying. Kept apart from REJECTED, an
  // employer's decision about someone they met, so neither the counts nor
  // the reliability score mix the two.
  SCREENED_OUT
}

model Application {
  id                String           @id @default(cuid())
  driveId           String
  candidateId       String
  slotId            String?
  state             ApplicationState @default(INTERESTED)
  stateChangedAt    DateTime         @default(now())
  // The answers given when applying, keyed by question id.
  knockoutAnswers   Json?
  // Shown to the candidate: what the requirement was, so they don't travel.
  screenedOutReason String?
  // The employer's private note, not part of the application's state.
  shortlistedAt     DateTime?
  shortlistedById   String?

  drive         Drive          @relation(fields: [driveId], references: [id])
  candidate     Candidate      @relation(fields: [candidateId], references: [id])
  slot          DriveSlot?     @relation(fields: [slotId], references: [id])
  shortlistedBy User?          @relation("ShortlistedBy", fields: [shortlistedById], references: [id])
  checkIn       CheckIn?
  thread        MessageThread?

  // One application per candidate per drive, enforced here rather than by a
  // check-then-insert, so two concurrent applies cannot both land. A release
  // is a move to WITHDRAWN, not a delete, so the row (and this guarantee)
  // survives and re-applying reuses it.
  @@unique([driveId, candidateId])
  @@index([candidateId])
  @@index([slotId])
  @@map("applications")
}

enum VoiceIntroStatus {
  UPLOADED
  PROCESSING
  DONE
  FAILED
}

// A candidate's recorded introduction. The audio is in MinIO under objectKey;
// the newest one is current and an older one is replacedAt the moment a new
// one is uploaded, after which the maintenance job deletes it, as it does any
// recording older than 180 days.
model VoiceIntro {
  id                  String           @id @default(cuid())
  candidateId         String
  objectKey           String           @unique
  contentType         String
  status              VoiceIntroStatus @default(UPLOADED)
  // An automatic transcript: never shown as what the candidate said.
  transcript          String?
  language            String?
  languageProbability Float?
  durationSeconds     Float?
  // Whisper's own confidence signals, kept so the interface can decide when
  // to lead with the audio instead of the text.
  avgLogprob          Float?
  noSpeechProb        Float?
  compressionRatio    Float?
  error               String?
  createdAt           DateTime         @default(now())
  processedAt         DateTime?
  replacedAt          DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId, createdAt])
  @@map("voice_intros")
}

enum CheckInMethod {
  SCAN
  WALK_IN
  MANUAL
}

// Location fields are null for a MANUAL check-in: the employer marked the
// person present, so there is no reading. isValid false means "accepted but
// needs an employer's confirmation", with the reason in flagReason.
model CheckIn {
  id             String        @id @default(cuid())
  applicationId  String        @unique
  method         CheckInMethod
  scannedAt      DateTime      @default(now())
  // Client-reported time of an offline scan that synced later; untrusted,
  // shown to the employer next to scannedAt, never used to accept a token.
  capturedAt     DateTime?
  lat            Float?
  lng            Float?
  accuracyMeters Float?
  distanceMeters Float?
  isValid        Boolean
  flagReason     String?

  application Application @relation(fields: [applicationId], references: [id])

  @@map("check_ins")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// One row per send attempt, so retries leave a trail instead of overwriting
// the last error. A partial unique index in the migration SQL (Prisma cannot
// express one) allows at most one PENDING or SENT row per drive, candidate
// and template: an attempt claims that slot before calling the provider, so
// no retry, redelivery or duplicate job can send the same alert twice.
model Notification {
  id                String             @id @default(cuid())
  candidateId       String
  driveId           String
  channel           String
  templateKey       String
  status            NotificationStatus
  attempt           Int
  jobId             String
  providerMessageId String?
  error             String?
  createdAt         DateTime           @default(now())
  sentAt            DateTime?
  // The drive's scheduleVersion the alert was about, for alerts that depend
  // on its time; part of the one-claim index.
  scheduleVersion   Int                @default(0)
  // Only for channels that report delivery; Telegram does not.
  deliveredAt       DateTime?
  // Set for the Telegram copy of a message; such rows are claimed by
  // message, not by drive and template (see the migration's indexes).
  messageId         String?

  candidate Candidate @relation(fields: [candidateId], references: [id])
  drive     Drive     @relation(fields: [driveId], references: [id])
  message   Message?  @relation(fields: [messageId], references: [id])

  @@index([driveId, candidateId])
  @@index([messageId])
  @@map("notifications")
}

// An owner's invitation to a phone number, the identity used everywhere
// else. The invitee signs in with OTP as anyone does and then joins with one
// tap, seeing the company's name first: Indian carriers reissue numbers, so
// a stranger may hold one an owner still has on file. A partial unique index
// in the migration allows one open invitation per company and phone; an
// accepted, revoked or expired row stays as history.
model CompanyInvitation {
  id           String      @id @default(cuid())
  companyId    String
  phone        String
  // What the company calls them. OTP sign-up names a user by their phone,
  // so this becomes their name on joining if they have no other.
  name         String
  role         CompanyRole
  invitedById  String
  createdAt    DateTime    @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  // Null when the system closed it: an expired invitation replaced by a new
  // one, or the inviter's own removal.
  revokedById  String?

  company    Company @relation(fields: [companyId], references: [id])
  invitedBy  User    @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?   @relation("AcceptedBy", fields: [acceptedById], references: [id])
  revokedBy  User?   @relation("RevokedBy", fields: [revokedById], references: [id])

  @@index([companyId])
  @@index([phone])
  @@map("company_invitations")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum LedgerOwnerType {
  COMPANY
  PLATFORM
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerReason {
  TOP_UP
  CHECK_IN_CHARGE
  PROMO_GRANT
}

// One account per owner and currency. ownerId is a company id for COMPANY, or
// the account's name for PLATFORM ("revenue", "gateway", "promotions"), so it
// has no foreign key. Balances are never stored: the ledger_balances view sums
// the entries.
model LedgerAccount {
  id        String          @id @default(cuid())
  ownerType LedgerOwnerType
  ownerId   String
  currency  String          @default("INR")
  createdAt DateTime        @default(now())

  entries LedgerEntry[]

  @@unique([ownerType, ownerId, currency])
  @@map("ledger_accounts")
}

// Append-only, and every txnId balances: both are enforced by triggers in the
// migration SQL, not here. txnId is predictable ("charge:checkin:<id>",
// "topup:<paymentId>"), so the unique index turns a retried write into a
// conflict instead of a second charge. Amounts are whole paise, always
// positive; direction says which way they move.
model LedgerEntry {
  id          String          @id @default(cuid())
  txnId       String
  accountId   String
  direction   LedgerDirection
  amountPaise Int
  reason      LedgerReason
  refType     String?
  refId       String?
  createdAt   DateTime        @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@unique([txnId, accountId, direction])
  @@index([accountId, createdAt])
  @@index([refType, refId])
  @@map("ledger_entries")
}

// Prices are data. A change is a new row with a later effectiveFrom, never an
// edit, so every past charge can be traced to the price it was made at.
model PricingRule {
  id            String   @id @default(cuid())
  event         String
  unit          String
  pricePaise    Int
  effectiveFrom DateTime
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([event, effectiveFrom])
  @@map("pricing_rules")
}

enum PaymentOrderStatus {
  CREATED
  CAPTURED
  FAILED
}

// A top-up the company started. Credited once, on capture, keyed on the
// gateway's payment id: one order can see several payment attempts.
model PaymentOrder {
  id               String             @id @default(cuid())
  companyId        String
  createdById      String
  gateway          String
  gatewayOrderId   String             @unique
  gatewayPaymentId String?            @unique
  amountPaise      Int
  currency         String             @default("INR")
  status           PaymentOrderStatus @default(CREATED)
  failureReason    String?
  createdAt        DateTime           @default(now())
  capturedAt       DateTime?

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([companyId, createdAt])
  @@map("payment_orders")
}

// Every webhook delivery as received, valid or not. rawBody is text, not
// JSON: the signature covers the exact bytes, and a JSON column would
// re-serialise them. A delivery whose signature fails keeps only its first
// 2 KB, with rawBodyBytes giving the full size: enough to diagnose, not
// enough for an unauthenticated sender to fill the disk.
model PaymentEvent {
  id               String   @id @default(cuid())
  gateway          String
  eventId          String?
  eventType        String?
  gatewayPaymentId String?
  signatureValid   Boolean
  rawBody          String
  rawBodyBytes     Int      @default(0)
  outcome          String?
  receivedAt       DateTime @default(now())

  @@index([eventId])
  @@index([gatewayPaymentId])
  @@map("payment_events")
}

enum SubmissionStatus {
  AWAITING_REVIEW
  APPROVED
  REJECTED
}

enum VerificationRejection {
  DOCUMENT_UNREADABLE
  DETAILS_DONT_MATCH
  GSTIN_INVALID
  NOT_A_BUSINESS
  OTHER
}

// One request for verification and how it was decided. A rejected company
// sends a new one rather than editing this, so the history of what was sent
// and decided stays. The provider's result is recorded as advice for the
// admin, who makes the decision.
model VerificationSubmission {
  id              String                 @id @default(cuid())
  companyId       String
  // Null for submissions backfilled from the GSTIN a company already had.
  submittedById   String?
  gstin           String
  documentKeys    String[]
  status          SubmissionStatus       @default(AWAITING_REVIEW)
  providerName    String?
  providerCode    String?
  providerParams  Json?
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason VerificationRejection?
  decisionNote    String?
  createdAt       DateTime               @default(now())

  company     Company @relation(fields: [companyId], references: [id])
  submittedBy User?   @relation("SubmittedBy", fields: [submittedById], references: [id])
  decidedBy   User?   @relation("DecidedBy", fields: [decidedById], references: [id])

  @@index([companyId, createdAt])
  @@index([status])
  @@map("verification_submissions")
}

enum ReportTarget {
  DRIVE
  CANDIDATE
  MESSAGE
}

// One enum for both targets; which reasons fit which target is
// REPORT_REASONS in @walkins/shared.
enum ReportReason {
  ASKS_FOR_MONEY
  NOT_A_REAL_JOB
  MISLEADING_PAY
  ABUSIVE
  FAKE_PROFILE
  OTHER
}

enum ReportOutcome {
  DISMISSED
  ACTIONED
}

// A report never changes anything by itself: it waits for an admin. That is
// what keeps logged-out reporting from being a way to take a drive down.
model Report {
  id              String         @id @default(cuid())
  targetType      ReportTarget
  driveId         String?
  candidateId     String?
  reason          ReportReason
  details         String?
  // Null for a logged-out report, which carries reporterNetwork instead: a
  // keyed hash of the address, enough to group one network's reports and
  // never the address itself.
  reporterUserId  String?
  reporterNetwork String?
  // A message report with neither reporter was filed by the money-request
  // tripwire, not by a person.
  messageId       String?
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?
  outcome         ReportOutcome?
  actionId        String?

  drive     Drive?            @relation(fields: [driveId], references: [id])
  candidate Candidate?        @relation(fields: [candidateId], references: [id])
  message   Message?          @relation(fields: [messageId], references: [id])
  reporter  User?             @relation(fields: [reporterUserId], references: [id])
  action    ModerationAction? @relation(fields: [actionId], references: [id])

  @@index([driveId, createdAt])
  @@index([candidateId, createdAt])
  @@index([messageId])
  @@index([reporterUserId])
  @@index([reporterNetwork])
  @@map("reports")
}

enum ModerationActionKind {
  DISMISS
  WARN
  SUSPEND_DRIVE
  SUSPEND_COMPANY
  LIFT_DRIVE
  LIFT_COMPANY
}

model ModerationAction {
  id          String               @id @default(cuid())
  kind        ModerationActionKind
  adminId     String
  driveId     String?
  companyId   String?
  candidateId String?
  note        String?
  createdAt   DateTime             @default(now())

  admin     User       @relation(fields: [adminId], references: [id])
  drive     Drive?     @relation(fields: [driveId], references: [id])
  company   Company?   @relation(fields: [companyId], references: [id])
  candidate Candidate? @relation(fields: [candidateId], references: [id])
  reports   Report[]
  warnings  Warning[]

  @@index([createdAt])
  @@map("moderation_actions")
}

// Shown to the company's people, or to the candidate, until someone
// acknowledges it: what was reported and, optionally, the admin's words.
model Warning {
  id               String       @id @default(cuid())
  actionId         String
  companyId        String?
  candidateId      String?
  reason           ReportReason
  note             String?
  createdAt        DateTime     @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?

  action         ModerationAction @relation(fields: [actionId], references: [id])
  company        Company?         @relation(fields: [companyId], references: [id])
  candidate      Candidate?       @relation(fields: [candidateId], references: [id])
  acknowledgedBy User?            @relation(fields: [acknowledgedById], references: [id])

  @@index([companyId])
  @@index([candidateId])
  @@map("warnings")
}

// One change of a drive's time, as it was announced: what the people booked
// knew before and what they were told after. version is the drive's
// scheduleVersion once this change was made.
model DriveReschedule {
  id           String   @id @default(cuid())
  driveId      String
  version      Int
  fromStartsAt DateTime
  fromEndsAt   DateTime
  toStartsAt   DateTime
  toEndsAt     DateTime
  // Bookings moved to another slot because theirs no longer existed.
  reseated     Int      @default(0)
  byId         String
  createdAt    DateTime @default(now())

  drive Drive @relation(fields: [driveId], references: [id])
  by    User  @relation(fields: [byId], references: [id])

  @@unique([driveId, version])
  @@map("drive_reschedules")
}

enum MessageSide {
  COMPANY
  CANDIDATE
}

// One per application, between the company and the candidate. It belongs to
// the company, not to whoever wrote first: everyone there reads it, which is
// also what keeps a rogue recruiter from working in private. Created by the
// first message from either side.
model MessageThread {
  id               String    @id @default(cuid())
  applicationId    String    @unique
  // The last seq handed out. Sending locks this row to take the next one, so
  // a thread's messages have one order everyone sees, whoever sends at once.
  lastSeq          Int       @default(0)
  lastMessageAt    DateTime?
  // Read markers are seqs, not times, so marking read can't skip a message
  // that committed a moment later. The company's is shared, like the desk,
  // with a note of who read last.
  companyReadSeq   Int       @default(0)
  companyReadById  String?
  companyReadAt    DateTime?
  candidateReadSeq Int       @default(0)
  createdAt        DateTime  @default(now())

  application   Application @relation(fields: [applicationId], references: [id])
  companyReadBy User?       @relation("CompanyReader", fields: [companyReadById], references: [id])
  messages      Message[]

  @@map("message_threads")
}

// Stored before anyone is told; the thread is the record, and the Telegram
// copy is a notification of it. Plain text, never edited or deleted.
model Message {
  id               String      @id @default(cuid())
  threadId         String
  seq              Int
  side             MessageSide
  senderId         String
  body             String
  // Set by the money-request tripwire (see moneyRequestSignals). Never
  // holds the message back: it decides when to shout, not what gets through.
  moneyFlag        Boolean     @default(false)
  flagReviewedAt   DateTime?
  flagReviewedById String?
  createdAt        DateTime    @default(now())

  thread         MessageThread  @relation(fields: [threadId], references: [id])
  sender         User           @relation("MessageSender", fields: [senderId], references: [id])
  flagReviewedBy User?          @relation("FlagReviewer", fields: [flagReviewedById], references: [id])
  notifications  Notification[]
  reports        Report[]

  @@unique([threadId, seq])
  @@index([createdAt])
  @@map("messages")
}
