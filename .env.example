# --- Postgres ---
POSTGRES_USER=walkins
POSTGRES_PASSWORD=walkins_dev_password
POSTGRES_DB=walkins
POSTGRES_PORT=5432
DATABASE_URL=postgresql://walkins:walkins_dev_password@localhost:5432/walkins
# API and worker tests run here, never against DATABASE_URL: the ledger is
# append-only, so rows a test commits can never be removed. Create it with
# `pnpm test:db`.
TEST_DATABASE_URL=postgresql://walkins:walkins_dev_password@localhost:5432/walkins_test

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO ---
MINIO_ROOT_USER=walkins_admin
MINIO_ROOT_PASSWORD=walkins_dev_password
MINIO_BUCKET=walkins-uploads
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false

# --- API (apps/api) ---
API_PORT=4000
JWT_SECRET=dev_only_change_me
# Signs the rotating check-in QR codes. Must differ from JWT_SECRET: the QR is
# on public display, and a code signed with the login secret would work as one.
CHECKIN_JWT_SECRET=dev_only_change_me_too
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=90
DEV_EXPOSE_OTP=true

# --- Web (apps/web) ---
WEB_PORT=3000
# Where the Next.js server reaches the API. Browsers never use it: they call
# same-origin /api, which Next proxies here (see README, "Testing on a phone").
API_INTERNAL_URL=http://localhost:4000
# Optional. This laptop's Wi-Fi IP address (e.g. 192.168.1.20). When set, the
# web app serves HTTPS on that address so a phone can use its camera and GPS.
LAN_HOST=

# --- ML sidecar (services/ml) ---
# Transcription and embeddings for the worker. ML_PORT is the host port
# docker compose publishes it on.
ML_PORT=8001
ML_URL=http://localhost:8001

# --- Payments (apps/api) ---
# mock (the default) runs the whole top-up flow with no network and no keys.
# razorpay needs test-mode keys from the Razorpay dashboard; the webhook secret
# is the one set on the webhook there, not the key secret.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shared ---
NODE_ENV=development

# --- Notifications (apps/worker, apps/api) ---
# Optional. Leave both blank and alerts are printed by the worker instead of
# sent, so nothing here is needed to run the project. With a bot from
# @BotFather, the token goes to the worker and the username (without the @)
# lets the profile page build the t.me link.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Base URL used for drive links inside alert messages.
WEB_URL=http://localhost:3000
TELEGRAM_BOT_USERNAME=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
